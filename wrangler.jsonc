{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forma-workout-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:8787",
    "BACKEND_URL": "http://127.0.0.1:3000",
  },
  "env": {
    // Private account staging: the hostname is protected by Cloudflare Access
    // and the API is reached only through an Access-protected Tunnel.
    "staging": {
      "name": "forma-workout-planner-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "forma-staging.raoufabedini.dev", "custom_domain": true },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://forma-staging.raoufabedini.dev",
        "BACKEND_URL": "https://forma-api-staging.raoufabedini.dev",
      },
    },
    // Public account site with a separate production database and protected origin.
    "production": {
      "name": "forma-workout-planner-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "forma.raoufabedini.dev", "custom_domain": true },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_ORIGIN": "https://forma.raoufabedini.dev",
        "BACKEND_URL": "https://forma-api.raoufabedini.dev",
      },
    },
  },
}
