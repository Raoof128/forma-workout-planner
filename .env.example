# Copy to /etc/forma/production.env, chmod 0600, and run Compose with --env-file.
# Use a different file and independent values for staging and production.
NODE_ENV=production
IMAGE_TAG=release-sha
APP_ORIGIN=https://your-real-app-domain.example
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ORIGIN_SHARED_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_SECRET
EMAIL_FROM='FORMA <accounts@your-verified-domain.example>'
CLOUDFLARE_EMAIL_API_TOKEN=REPLACE_WITH_EMAIL_SENDING_TOKEN
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_32_CHARACTER_ACCOUNT_ID
EMAIL_SINK_ENABLED=false

# Credentials belong to separately provisioned PostgreSQL roles.
APP_DB_PASSWORD=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
MIGRATION_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_64_LOWERCASE_HEX_CHARACTERS
DATABASE_URL=postgres://forma_runtime:${APP_DB_PASSWORD}@db:5432/forma
MIGRATION_DATABASE_URL=postgres://forma_migrator:${MIGRATION_DB_PASSWORD}@db:5432/forma
POSTGRES_ADMIN_PASSWORD_FILE=/etc/forma/secrets/postgres-admin-password

# Cloudflare Tunnel token file is readable only by the deployment operator.
CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/forma/secrets/cloudflare-tunnel-token

# Backup tools use an age recipient (public key) and rclone destination name.
BACKUP_AGE_RECIPIENT=age1replace_with_offhost_backup_recipient
BACKUP_REMOTE=forma-backups:production/postgres
