{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "forma-operations-dashboard",
  "main": "dashboard.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../.forma-dashboard-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "routes": [
    {
      "pattern": "forma-ops.raoufabedini.dev",
      "custom_domain": true,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "7a2e60e917f849339e43135687984f9a",
    },
  ],
  "vars": {
    "HOSTNAME": "forma-ops.raoufabedini.dev",
    "ACCESS_ISSUER": "https://broad-scene-47dd.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "5f357ed4d3eb75800df82f9b6ccbd5d66c2c887f715d27bccfb01fce7b0ba50d",
    "OWNER_EMAIL": "raoof.r12@gmail.com",
  },
}
