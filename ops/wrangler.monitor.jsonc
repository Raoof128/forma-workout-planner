{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "forma-operations-monitor",
  "main": "edge-monitor.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    { "binding": "STATE", "id": "7a2e60e917f849339e43135687984f9a" },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "r2_buckets": [
    { "binding": "BACKUPS", "bucket_name": "forma-production-backups" },
  ],
  "vars": {
    "APP_ORIGIN": "https://forma.raoufabedini.dev",
    "CLOUDFLARE_ACCOUNT_ID": "25c840ad25d38d8f35099180d2c1feab",
    "EMAIL_FROM": "accounts@mail-staging-forma.raoufabedini.dev",
    "ALERT_TO": "raoof.r12@gmail.com",
  },
}
